# ========================================
# OpenShift UI Test Framework Configuration
# ========================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual values below
# 3. Never commit .env file to git (it's in .gitignore)


CONSOLE_URL=https://console-openshift-console.apps.example.com
CONSOLE_USERNAME=kubeadmin
CONSOLE_PASSWORD=your-password-here

# Optional: explicit API URL for CLI login (overrides derivation from CONSOLE_URL)
# Useful for clusters where the API hostname differs from the console hostname pattern.
# In CI/Prow, an existing KUBECONFIG is used automatically — no login is needed.
# API_URL=https://api.example.com:6443

# Application timeout for element waits and page operations
APP_TIMEOUT=90000

# Authentication type: "kube:admin", "htpasswd", or "direct" (no OAuth provider selection)
AUTH_TYPE=kube:admin

# Artifact capture settings (screenshots and video recordings on test failure)
# Set to "true" to enable, "false" to disable (default: false)
CAPTURE_SCREENSHOTS=false
CAPTURE_RECORDINGS=false
# Directory where screenshots and recordings are saved
ARTIFACTS_DIR=/tmp/test-artifacts

# ========================================
# Operator Installation Configuration
# ========================================
# Same env vars used by release-tests-infra

# Set to "true" to install/verify the operator before tests run.
# Set to "false" to skip operator installation and proceed directly with tests.
INSTALL_PIPELINES_OPERATOR=true

# Operator environment: "prod", "stage", or "pre-stage"
#   prod      -> uses redhat-operators CatalogSource (GA builds)
#   stage     -> uses custom-operators CatalogSource (stage builds)
#   pre-stage -> uses custom-operators CatalogSource (Konflux builds)
OPERATOR_ENVIRONMENT=prod

# OLM channel for operator subscription (e.g. "latest", "pipelines-1.17")
CHANNEL=latest

# Operator version to pin (e.g. "1.17.1"). Leave empty for latest on the channel.
# When set, a startingCSV is pinned and InstallPlan approval is set to Manual.
# OPERATOR_VERSION=

# CatalogSource name. Auto-defaults based on OPERATOR_ENVIRONMENT:
#   prod       -> redhat-operators
#   stage      -> custom-operators
#   pre-stage  -> custom-operators
# CATALOG_SOURCE=

# Konflux index image URL (required for pre-stage and stage).
# For prod, leave empty.
# KONFLUX_INDEX_IMAGE=

# Installation method: "cli" (default) or "ui"
#   cli -> creates Subscription YAML via oc apply (supports version pinning via startingCSV)
#   ui  -> installs via the console Software Catalog (Ecosystem > Software Catalog);
#          OperatorHub was replaced by the Software Catalog in OCP 4.22
# Both methods honour OPERATOR_VERSION: the Software Catalog panel has a version
# selector, so "ui" no longer falls back to CLI for a pinned version.
# OSP_INSTALL_METHOD=cli

# Force nightly handling for an index image that is not tagged ":nightly".
# Nightly is otherwise detected from the KONFLUX_INDEX_IMAGE tag. When nightly:
#   - an ImageDigestMirrorSet (pipelines-mirror) is applied for the nightly registries
#   - the channel head is installed and OPERATOR_VERSION is NOT pinned, because it is
#     a channel-ish value there (e.g. "5.0") rather than a real CSV version
# NIGHTLY=false

# Global timeout in seconds for the entire operator setup flow (default: 600 = 10 min)
# OSP_SETUP_TIMEOUT=600
